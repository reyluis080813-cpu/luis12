--==================================================
-- FUNCIONES
--==================================================

local function getCharacter()
	return player.Character or player.CharacterAdded:Wait()
end

local function getRoot()
	local character = getCharacter()
	return character:FindFirstChild("HumanoidRootPart")
end

local function findBase()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if BASE_NAMES[obj.Name] and obj:IsA("BasePart") then
			return obj
		end
	end

	return nil
end

local function getEggs()
	local eggs = {}

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if EGG_NAMES[obj.Name] then
			if obj:IsA("BasePart") or obj:IsA("Model") then
				table.insert(eggs, obj)
			end
		end
	end

	return eggs
end

local function getObjectPosition(obj)
	if obj:IsA("BasePart") then
		return obj.Position
	elseif obj:IsA("Model") then
		return obj:GetPivot().Position
	end

	return nil
end

local function teleportTo(position)
	local root = getRoot()

	if root and position then
		root.CFrame = CFrame.new(position + Vector3.new(0, 4, 0))
	end
end

--==================================================
-- CREAR BOTONES DE EGGS
--==================================================

local function clearList()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextButton") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end
end

local function refreshEggs()
	clearList()

	local filter = string.lower(search.Text)
	local eggs = getEggs()

	local shown = 0

	for _, egg in ipairs(eggs) do
		if filter == "" or string.find(string.lower(egg.Name), filter, 1, true) then

			shown += 1

			local button = Instance.new("TextButton")
			button.Size = UDim2.new(1, -4, 0, 42)
			button.BackgroundColor3 = Color3.fromRGB(31, 34, 47)
			button.Text = "🥚  " .. egg.Name
			button.TextColor3 = Color3.fromRGB(235, 235, 245)
			button.TextSize = 13
			button.Font = Enum.Font.GothamMedium
			button.BorderSizePixel = 0
			button.AutoButtonColor = false
			button.Parent = list

			local buttonCorner = Instance.new("UICorner")
			buttonCorner.CornerRadius = UDim.new(0, 8)
			buttonCorner.Parent = button

			button.MouseEnter:Connect(function()
				TweenService:Create(
					button,
					TweenInfo.new(0.15),
					{BackgroundColor3 = Color3.fromRGB(48, 42, 75)}
				):Play()
			end)

			button.MouseLeave:Connect(function()
				TweenService:Create(
					button,
					TweenInfo.new(0.15),
					{BackgroundColor3 = Color3.fromRGB(31, 34, 47)}
				):Play()
			end)

			button.Activated:Connect(function()
				local position = getObjectPosition(egg)

				if position then
					teleportTo(position)
				end
			end)
		end
	end

	if shown == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, -10, 0, 50)
		empty.BackgroundTransparency = 1
		empty.Text = "No se encontraron Eggs"
		empty.TextColor3 = Color3.fromRGB(130, 135, 155)
		empty.TextSize = 13
		empty.Font = Enum.Font.Gotham
		empty.Parent = list
	end

	task.wait()

	list.CanvasSize = UDim2.fromOffset(
		0,
		layout.AbsoluteContentSize.Y + 16
	)
end

